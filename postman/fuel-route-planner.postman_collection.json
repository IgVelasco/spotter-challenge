{
  "info": {
    "name": "Fuel Route Planner",
    "description": "Route + fuel stop planning API. Set baseUrl (default http://localhost:8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/health/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health",
            ""
          ]
        }
      }
    },
    {
      "name": "Plan: Chicago to Denver (2 stops)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"has fuel stops\", () => pm.expect(pm.response.json().fuel_stops.length).to.be.above(0));",
              "pm.test(\"has a total cost\", () => pm.expect(pm.response.json().fuel_summary.total_fuel_cost_usd).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ]
        }
      }
    },
    {
      "name": "Plan: Los Angeles to New York (coast to coast)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"has fuel stops\", () => pm.expect(pm.response.json().fuel_stops.length).to.be.above(0));",
              "pm.test(\"has a total cost\", () => pm.expect(pm.response.json().fuel_summary.total_fuel_cost_usd).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Los Angeles, CA\",\n  \"finish\": \"New York, NY\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ]
        }
      }
    },
    {
      "name": "Plan: coordinates + starting fuel price",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"has fuel stops\", () => pm.expect(pm.response.json().fuel_stops.length).to.be.above(0));",
              "pm.test(\"starting fuel is costed\", () => pm.expect(pm.response.json().fuel_summary.starting_fuel_cost_usd).to.not.equal(null));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": {\n    \"latitude\": 47.6062,\n    \"longitude\": -122.3321\n  },\n  \"finish\": \"25.7617,-80.1918\",\n  \"starting_fuel_price_usd\": \"3.50\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ]
        }
      }
    },
    {
      "name": "Plan: short trip, no stops needed",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"no stops\", () => pm.expect(pm.response.json().fuel_stops).to.have.lengthOf(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Austin, TX\",\n  \"finish\": \"Dallas, TX\",\n  \"starting_fuel_price_usd\": \"3.10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ]
        }
      }
    },
    {
      "name": "Error: unknown city",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"error envelope\", () => pm.expect(pm.response.json().error.code).to.equal(\"invalid_request\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Atlantis, NV\",\n  \"finish\": \"Denver, CO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ]
        }
      }
    },
    {
      "name": "Error: outside the US",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"48.8566,2.3522\",\n  \"finish\": \"Denver, CO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ]
        }
      }
    },
    {
      "name": "Map: Chicago to Denver (open in browser)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/map/?start=Chicago, IL&finish=Denver, CO",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            "map",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Denver, CO"
            }
          ]
        }
      }
    }
  ]
}
